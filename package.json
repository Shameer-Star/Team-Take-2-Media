{
  "name": "take-two-os",
  "version": "1.0.0",
  "description": "TAKE TWO OS - Internal Business & Team Management Platform for Team Take Two Media",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start": "cd server && npm start",
    "build": "cd client && npm run build",
    "seed": "cd server && npx tsx src/database.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
